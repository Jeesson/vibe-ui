{
    "name": "@jeesson/vibe-ui",
    "version": "0.1.1",
    "type": "module",
    "description": "Vibe UI — a Vue 3 component library for vibe coders: 50+ components, dark/light themes, Tailwind CSS 4, TypeScript, interactive docs playground",
    "keywords": [
        "vue",
        "vue3",
        "vue-components",
        "component-library",
        "ui",
        "ui-components",
        "tailwind",
        "tailwindcss",
        "dark-mode",
        "typescript",
        "vite",
        "vibe-ui",
        "vibe-coding",
        "design-system",
        "components",
        "frontend"
    ],
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jeesson/vibe-ui.git"
    },
    "homepage": "https://vibe-ui.pages.dev/",
    "bugs": {
        "url": "https://github.com/Jeesson/vibe-ui/issues"
    },
    "main": "./dist/vibe-ui.cjs.js",
    "module": "./dist/vibe-ui.es.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/vibe-ui.es.js",
            "require": "./dist/vibe-ui.cjs.js",
            "types": "./dist/index.d.ts"
        },
        "./style.css": "./dist/vibe-ui.css"
    },
    "peerDependencies": {
        "vue": "^3.4.0"
    },
    "scripts": {
        "dev": "vite --config vite.playground.config.ts",
        "build": "bun run build:library",
        "build:library": "vue-tsc --noEmit && vue-tsc -p tsconfig.build.json && vite build --config vite.library.config.ts",
        "build:playground": "vite build --config vite.playground.config.ts",
        "preview": "vite preview --config vite.playground.config.ts"
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "@types/node": "^26.5.1",
        "lucide-vue-next": "^1.0.0",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.1.0",
        "vue": "^3.5.42",
        "vue-tsc": "^3.3.11"
    }
}
