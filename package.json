{
    "name": "complex-ui",
    "version": "0.1.0",
    "type": "module",
    "description": "A Vue 3 component library with an interactive documentation playground",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/Jeesson/complex-ui.git"
    },
    "homepage": "https://complex-ui.pages.dev/",
    "bugs": {
        "url": "https://github.com/Jeesson/complex-ui/issues"
    },
    "main": "./dist/complex-ui.cjs.js",
    "module": "./dist/complex-ui.es.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/complex-ui.es.js",
            "require": "./dist/complex-ui.cjs.js",
            "types": "./dist/index.d.ts"
        },
        "./style.css": "./dist/complex-ui.css"
    },
    "peerDependencies": {
        "vue": "^3.4.0"
    },
    "scripts": {
        "dev": "vite --config vite.playground.config.ts",
        "build": "bun run build:library",
        "build:library": "vue-tsc --noEmit && vue-tsc -p tsconfig.build.json && vite build --config vite.library.config.ts",
        "build:playground": "vite build --config vite.playground.config.ts",
        "preview": "vite preview --config vite.playground.config.ts"
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "lucide-vue-next": "^1.0.0",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.1.0",
        "vue": "^3.5.42",
        "vue-tsc": "^3.3.11"
    }
}
